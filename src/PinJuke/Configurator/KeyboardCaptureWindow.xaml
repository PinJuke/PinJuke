<Window x:Class="PinJuke.Configurator.KeyboardCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PinJuke.Configurator"
        xmlns:pinjuke="clr-namespace:PinJuke"
        xmlns:configuration="clr-namespace:PinJuke.Configuration"
        mc:Ignorable="d"
        Title="PinJuke" Height="200" Width="400" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Margin="20,20,20,0" Text="{x:Static pinjuke:Strings.CaptureKeyboardKey}" TextWrapping="Wrap" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
            <Button Width="100" Content="{x:Static pinjuke:Strings.Cancel}" Margin="5" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
