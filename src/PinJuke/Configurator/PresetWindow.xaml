<Window x:Class="PinJuke.Configurator.PresetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PinJuke.Configurator"
        xmlns:pinjuke="clr-namespace:PinJuke"
        xmlns:configuration="clr-namespace:PinJuke.Configuration"
        mc:Ignorable="d"
        Title="PinJuke" Height="200" Width="400" WindowStartupLocation="CenterScreen">
    <Grid FocusManager.FocusedElement="{Binding ElementName=Presets}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="20,20,20,0" Text="{x:Static pinjuke:Strings.SelectFromPresets}" TextWrapping="Wrap" />

        <ComboBox Grid.Row="1" x:Name="Presets" Margin="20,20,20,0" SelectionChanged="ComboBox_SelectionChanged" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Width="100" Content="{x:Static pinjuke:Strings.Ok}" Margin="5" IsDefault="True" Click="OkButton_Click"/>
            <Button Width="100" Content="{x:Static pinjuke:Strings.Cancel}" Margin="5" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
